# Copy this file to `.env` and fill in your key.
DEEPSEEK_API_KEY=

# Optional: run the assistant on a local Ollama model instead.
# KLEEP_ASSISTANT_PROVIDER=ollama
# KLEEP_OLLAMA_MODEL=qwen3.5:9b
# KLEEP_OLLAMA_URL=http://127.0.0.1:11434
# KLEEP_OLLAMA_NUM_CTX=16384

# Optional: voice service tuning.
# KLEEP_TTS_PIPER_VOICE_EN=en_US-lessac-medium
# KLEEP_TTS_PIPER_VOICE_ES=es_ES-davefx-medium
